{
  "name": "dsh-client-ui-mobile-adapt",
  "description": "Mobile adaptation for the DeepSeek Harness Web GUI: single-column layout, sidebar drawer, compact header/composer, fullscreen settings, trajectory floating details, stats pill panel",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hotsteel2901/dsh-client-ui-mobile-adapt.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.3-alpha.1": "incompatible",
        "0.1.3-alpha.2": "incompatible",
        "0.1.5-alpha.1": "incompatible",
        "0.1.5-alpha.2": "incompatible",
        "0.1.5-rc.1": "incompatible",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "compatible",
        "0.1.6-alpha.1": "compatible",
        "0.1.6-alpha.2": "compatible",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      }
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/unit.test.mjs",
    "test:e2e": "python3 tools/regress.py"
  }
}
